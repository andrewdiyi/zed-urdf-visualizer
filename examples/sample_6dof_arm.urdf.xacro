<?xml version="1.0"?>
<robot name="zed_demo_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="upper_arm_len" default="0.32"/>
  <xacro:arg name="forearm_len" default="0.26"/>
  <xacro:arg name="with_gripper" default="true"/>

  <xacro:property name="l1" value="$(arg upper_arm_len)"/>
  <xacro:property name="l2" value="$(arg forearm_len)"/>
  <xacro:property name="base_radius" value="0.09"/>

  <material name="slate_dark">
    <color rgba="0.22 0.25 0.32 1.0"/>
  </material>
  <material name="zed_blue">
    <color rgba="0.18 0.52 0.92 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.78 0.81 0.86 1.0"/>
  </material>
  <material name="accent_orange">
    <color rgba="0.95 0.52 0.14 1.0"/>
  </material>

  <xacro:macro name="arm_segment" params="name length radius mass mat">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="${mat}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius * 1.08}" length="${length}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${length / 2.0}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (3 * radius * radius + length * length) / 12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (3 * radius * radius + length * length) / 12.0}"
          iyz="0.0"
          izz="${0.5 * mass * radius * radius}"/>
      </inertial>
    </link>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="0.07"/>
      </geometry>
      <material name="slate_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${base_radius}" length="0.07"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="2.4"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.010"/>
    </inertial>
  </link>

  <link name="shoulder_turret">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.11 0.10"/>
      </geometry>
      <material name="zed_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.11 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.0022" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0024"/>
    </inertial>
  </link>

  <joint name="waist_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_turret"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="50" velocity="2.5"/>
  </joint>

  <xacro:arm_segment name="upper_arm_link" length="${l1}" radius="0.038" mass="1.6" mat="silver"/>

  <joint name="shoulder_pitch_joint" type="revolute">
    <parent link="shoulder_turret"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.09" rpy="0 0.35 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1" upper="2.1" effort="45" velocity="2.5"/>
  </joint>

  <xacro:arm_segment name="forearm_link" length="${l2}" radius="0.030" mass="1.1" mat="zed_blue"/>

  <joint name="elbow_pitch_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 ${l1}" rpy="0 0.55 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="30" velocity="3.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.09 0.05"/>
      </geometry>
      <material name="accent_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.09 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="wrist_roll_joint" type="continuous">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 ${l2}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:if value="$(arg with_gripper)">
    <link name="left_finger_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://zed_urdf_demo/meshes/gripper_finger.stl" scale="1 1 1"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="0.009 0 0.042" rpy="0 0 0"/>
        <geometry>
          <box size="0.018 0.016 0.085"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.008 0 0.035" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="left_finger_slide_joint" type="prismatic">
      <parent link="wrist_link"/>
      <child link="left_finger_link"/>
      <origin xyz="-0.02 0.022 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.035" effort="15" velocity="0.5"/>
    </joint>

    <link name="right_finger_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://zed_urdf_demo/meshes/gripper_finger.stl" scale="1 1 1"/>
        </geometry>
        <material name="silver"/>
      </visual>
      <collision>
        <origin xyz="-0.009 0 0.042" rpy="0 0 0"/>
        <geometry>
          <box size="0.018 0.016 0.085"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="-0.008 0 0.035" rpy="0 0 0"/>
        <mass value="0.12"/>
        <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="right_finger_slide_joint" type="prismatic">
      <parent link="wrist_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0.02 -0.022 0.05" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.035" effort="15" velocity="0.5"/>
    </joint>
  </xacro:if>
</robot>
